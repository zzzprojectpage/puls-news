{
  "name": "PULS News",
  "short_name": "PULS",
  "id": "puls-news-android",
  "description": "A phone-local Romanian news reader with an embedded offline snapshot.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "ro",
  "categories": ["news"],
  "background_color": "#f2f0e9",
  "theme_color": "#111816",
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
